  "keywords": [
    "inkdrop",
    "markdown"
  ],
  "repository": "https://github.com/khouwdevin/inkdrop-goldgreen-dark",
  "author": "khouwdevin<khouwdevin@gmail.com>",
  "license": "MIT",
  "devDependencies": {
    "@inkdropapp/theme-dev-helpers": "^0.6.1"
  },
  "engines": {
    "inkdrop": "^6.0.0"
  }
}
