{
  "name": "goldgreen-dark",
  "description": "Gold and green theme (UI, syntax and preview) for Inkdrop",
  "version": "2.1.2",
  "theme": true,
  "themeAppearance": "dark",
  "type": "module",
  "styleSheets": [
    "palette.css",
    "ui.css",
    "syntax.css",
    "preview.css"
  ],
  "scripts": {
    "dev": "dev-server",
    "generate": "generate-palette",
    "prepublishOnly": "node node_modules/@inkdropapp/theme-dev-helpers/bin/generate-palette"
